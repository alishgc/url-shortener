<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <div class="dashboard-container">

      <!-- Top Header with Title & Logout -->
      <div class="dashboard-header">
        <h1>Dashboard</h1>
        <form action="/auth/logout" method="POST" class="logout-form">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>

      <% if (message) { %>
          <p class="message"><%= message %></p>
      <% } %>

      <!-- Shorten URL Form -->
      <form action="/urls" method="POST" class="shorten-form">
        <input type="url" name="url" placeholder="Paste your long URL here..." required />
        <button type="submit">Shorten URL</button>
      </form>

      <hr />

      <h2>Your URLs</h2>

      <!-- URLs List -->
      <% if (urls.length === 0) { %>
        <p class="empty-state">You haven't shortened any URLs yet.</p>
      <% } else { %>
        <div class="url-list">
          <% urls.forEach(url => { %>
            <div class="url-card">
              <div class="url-info">
                <p>
                  <strong>Original:</strong>
                  <a href="<%= url.original_url %>" target="_blank"><%= url.original_url %></a>
                </p>
                <p>
                  <strong>Short:</strong>
                  <a href="/<%= url.short_code %>" target="_blank">/<%= url.short_code %></a>
                </p>
                <p>
                  <strong>Clicks:</strong> <span><%= url.click_count %></span>
                </p>
              </div>

              <form action="/urls/<%= url.id %>" method="POST" class="delete-form">
                <button type="submit">Delete</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </body>
</html>